{#
/**
 * @file
 * Theme override to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessMaintenancePage()
 */
#}
{{ attach_library('villa_promenade/maintenance-page') }}
<div class="villa-maintenance">
  <header class="villa-maintenance__hero">
    <a class="villa-maintenance__brand" href="{{ front_page }}" rel="home">
      <img class="villa-maintenance__logo" src="{{ base_path ~ directory }}/images/logo-top-white.png" alt="Villa Promenade — EST. 1660" width="1800" height="833" fetchpriority="high">
    </a>
  </header>

  <main id="main-content" class="villa-maintenance__main" tabindex="-1" aria-labelledby="maintenance-title">
    <p class="villa-maintenance__eyebrow">{{ 'Hamarosan érkezünk!'|t }}</p>
    <h1 id="maintenance-title" class="villa-maintenance__title">{{ 'Rövidesen online is minden fontos információt megtalálsz nálunk.'|t }}</h1>
    {{ page.highlighted }}

    <a class="villa-maintenance__contact" href="mailto:event@villapromenade.hu">event@villapromenade.hu</a>
  </main>

  {% if page.sidebar_first %}
    <aside class="villa-maintenance__sidebar">
      {{ page.sidebar_first }}
    </aside>
  {% endif %}
  {% if page.sidebar_second %}
    <aside class="villa-maintenance__sidebar">
      {{ page.sidebar_second }}
    </aside>
  {% endif %}

  <footer class="villa-maintenance__footer">
    <address class="villa-maintenance__address">2000 Szentendre, Futó utca 4.</address>
    <a class="villa-maintenance__login" href="{{ path('user.login') }}">login</a>
    {{ page.footer }}
  </footer>
</div>
